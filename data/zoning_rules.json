  "dwellings_per_plot": "dwellings allowed per minimum plot (1 = single-family)",
  "far": "net buildability (edificabilitat neta), m² built per m² of plot",
  "height_by_slope": "[[slope % above which it applies, max height m], …] (first entry from 0)",
  "m2_per_dwelling": "alternative density rule: plot m² needed per dwelling",
  "max_coverage_pct": "maximum plot coverage (ocupació màxima), %",
  "max_dwellings": "cap on dwellings per plot regardless of size (e.g. 2 = up to two-family)",
  "max_floors": "maximum floors above ground, counting ground floor (PB+1 = 2)",
  "max_footprint_m2": "cap on footprint in m², on top of the coverage %",
  "max_height_m": "maximum height (alçada reguladora), m",
  "min_frontage_m": "minimum street frontage per plot (façana mínima), m",
  "min_plot_m2": "minimum plot size (parcel·la mínima), m²",
  "no_new_splits": "true if plots can't be subdivided beyond the layout fixed in the plans",
  "source": "where the numbers come from (article / page of the normes)"
